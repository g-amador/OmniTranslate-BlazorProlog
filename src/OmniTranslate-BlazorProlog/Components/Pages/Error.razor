@page "/Error"
@using System.Diagnostics

<!-- Sets the browser tab title -->
<PageTitle>Error</PageTitle>

<!-- Main error heading -->
<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

<!--
    Shows the Request ID only when available.
    Useful for correlating logs on the server with what the user saw.
-->
@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<!-- Developer guidance section -->
<h3>Development Mode</h3>
<p>
    Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
</p>
<p>
    <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
    It can result in displaying sensitive information from exceptions to end users.
    For local debugging, enable the <strong>Development</strong> environment by setting the
    <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
    and restarting the app.
</p>

@code {
    // Blazor injects the HttpContext when running on the server.
    // It may be null in some hosting models.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Stores the unique request identifier for debugging.
    private string? RequestId { get; set; }

    // Only show the Request ID if it exists.
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    // On initialization, capture the request ID.
    // Activity.Current?.Id is used when distributed tracing is enabled.
    // Otherwise, fall back to HttpContext.TraceIdentifier.
    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
