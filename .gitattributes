# Force GitHub Linguist to count C#, Razor, and Prolog files
*.cs linguist-detectable=true
*.razor linguist-detectable=true
*.pl linguist-detectable=true

# Explicitly classify Razor files as C#
*.razor linguist-language=C#

# Optional: classify .cs files as C# (usually automatic)
*.cs linguist-language=C#

# Explicitly classify .pl files as Prolog
*.pl linguist-language=Prolog

# Prevent build artifacts from being counted
bin/* linguist-generated=true
obj/* linguist-generated=true
